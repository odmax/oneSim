generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INTERNAL_ADMIN
  BUSINESS_USER
}

enum BusinessStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BusinessUserRole {
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum InternalAdminRole {
  SUPER_ADMIN
  ADMIN
  CEO
  SALES_TEAM
  OPERATIONS_MANAGER
  PRODUCT_MANAGER
  SUPPORT_MANAGER
  SUPPORT_AGENT
  ANALYTICS_MANAGER
  FINANCE_MANAGER
  READ_ONLY
}

enum PackageSource {
  PROVIDER_PLAN
  CATALOG_PRODUCT
  MANUAL
}

enum ProductType {
  NEW_ESIM
  TOP_UP
  BOTH
}

enum ProviderType {
  /// Legacy — use CUSTOM for all new providers
  IBASIS
  /// Legacy — use CUSTOM for all new providers
  CHOICE
  MOCK
  CUSTOM
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  MAINTENANCE
  INACTIVE
  TESTING
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessUsers         BusinessUser[]
  internalAdmin         InternalAdmin?
  purchases             ESIMPurchase[]
  topUpRequests         WalletTopUpRequest[] @relation("TopUpRequestedBy")
  approvedTopUpRequests WalletTopUpRequest[] @relation("TopUpApprovedBy")
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
  createdTickets        SupportTicket[]      @relation("TicketCreator")
  assignedTickets       SupportTicket[]      @relation("TicketAssignee")
  auditNotes            ProviderAuditNote[]
  orderTimelineEvents   OrderTimelineEvent[]
  catalogChangeSets     CatalogChangeSet[]   @relation("UserChangeSets")
  ruleExecutions        RuleExecution[]      @relation("UserRuleExecutions")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  type      String    @default("SET_PASSWORD") // SET_PASSWORD | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("password_reset_tokens")
}

model Business {
  id            String         @id @default(cuid())
  name          String
  regNumber     String?
  taxId         String?
  contactEmail  String
  contactPhone  String?
  address       String?
  country       String
  status        BusinessStatus @default(PENDING)
  walletBalance Decimal        @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users               BusinessUser[]
  purchases           ESIMPurchase[]
  invoices            Invoice[]
  transactions        WalletTransaction[]
  topUpRequests       WalletTopUpRequest[]
  esimTopUps          ESIMTopUp[]               @relation("BusinessESIMTopUps")
  supportTickets      SupportTicket[]
  customers           Customer[]
  apiKeys             BusinessApiKey[]
  webhookEndpoints    BusinessWebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  apiRequestLogs      ApiRequestLog[]
  rateLimitPerMinute  Int?
  pricingRules        PricingRule[]
  assignedSalesUserId String?

  salesAgent     InternalAdmin?  @relation("SalesAssignment", fields: [assignedSalesUserId], references: [id])
  billingRecords BillingRecord[] @relation("BillingRecordBusiness")

  @@map("businesses")
}

model BusinessUser {
  id         String           @id @default(cuid())
  userId     String
  businessId String
  role       BusinessUserRole @default(MEMBER)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("business_users")
}

model InternalAdmin {
  id          String            @id @default(cuid())
  userId      String            @unique
  role        InternalAdminRole @default(ADMIN)
  permissions Json?
  isActive    Boolean           @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedBusinesses Business[]      @relation("SalesAssignment")
  billingRecords     BillingRecord[] @relation("BillingRecordSalesAgent")

  @@map("internal_admins")
}

model Provider {
  id                       String         @id @default(cuid())
  name                     String
  code                     String         @unique
  type                     ProviderType
  adapterStrategy          String?
  authType                 String?        @default("bearer_token")
  apiVersion               String?        @default("v1")
  apiBaseUrl               String?
  authUrl                  String?
  apiToken                 String?
  tokenPlacement           String?        @default("URL_PATH")
  planListPath             String?
  activationPath           String?
  statusPath               String?
  usagePath                String?
  suspendPath              String?
  resumePath               String?
  topUpPath                String?
  responseListKey          String?
  environment              String         @default("staging")
  status                   ProviderStatus @default(ACTIVE)
  priority                 Int            @default(0)
  isDefaultFallback        Boolean        @default(false)
  regions                  Json? /// Array of supported region/country codes for routing
  supportsESIM             Boolean        @default(true)
  supportsUsage            Boolean        @default(false)
  supportsTopUp            Boolean        @default(false)
  supportsSuspend          Boolean        @default(false)
  supportsQRCode           Boolean        @default(false)
  supportsPools            Boolean        @default(false)
  supportsTemplates        Boolean        @default(false)
  supportsUsageSync        Boolean        @default(false)
  supportsWebhookPush      Boolean        @default(false)
  supportsSuspendResume    Boolean        @default(false)
  endpointMappings         Json?
  requestMappings          Json?
  responseMappings         Json?
  fieldMappings            Json?
  config                   Json?
  providerTemplateId       String?
  requiredConfigFields     Json?
  optionalConfigFields     Json?
  enabledCapabilities      Json?
  /// Health tracking fields
  lastSuccessfulConnection DateTime?
  lastFailedConnection     DateTime?
  activationSuccessRate    Float? /// Percentage 0-100
  averageActivationTimeMs  Int?
  errorCount               Int?           @default(0)
  lastError                String? /// Last error message
  lastSyncAt               DateTime? /// Last successful plan sync
  lastSyncResult           String? /// Summary of last sync result
  lastSyncCount            Int? /// Number of plans fetched in last sync
  /// Certification workflow fields
  certificationStatus      String?        @default("CONFIGURING")
  certifiedAt              DateTime?
  certificationNotes       String?
  lastCertificationRunAt   DateTime?
  /// Catalog management fields
  catalogPriority          Int            @default(100)
  autoPublishEnabled       Boolean        @default(false)
  /// Provider Framework V2 linkage (nullable — V1 continues working without these)
  pv2TemplateId            String?
  pv2TemplateVersionId     String?
  pv2ConfigStatus          String? /// NOT_CONFIGURED | CONFIGURING | CONFIGURED | VALIDATED
  pv2MigrationStatus       String? /// NOT_STARTED | IN_PROGRESS | COMPLETED | FAILED | ROLLED_BACK
  pv2LastValidationResult  Json?
  pv2LastTemplateUpgradeAt DateTime?
  pv2EnabledFeaturePacks   Json?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  packages                ESIMPackage[]
  providerPackages        ProviderPackage[]
  healthSnapshots         ProviderHealthSnapshot[]
  audits                  ProviderAudit[]
  providerTemplate        ProviderTemplate?                @relation("ProviderTemplateRelation", fields: [providerTemplateId], references: [id])
  pv2Template             PV2Template?                     @relation(fields: [pv2TemplateId], references: [id], onDelete: SetNull)
  pv2TemplateVersion      PV2TemplateVersion?              @relation(fields: [pv2TemplateVersionId], references: [id], onDelete: SetNull)
  pv2FeaturePackOverrides PV2ProviderFeaturePackOverride[]
  purchases               ESIMPurchase[]
  billingRecords          BillingRecord[]                  @relation("BillingRecordProvider")
  configurationRules      PackageConfigurationRule[]       @relation("ProviderConfigurationRules")

  @@index([pv2TemplateId])
  @@index([pv2TemplateVersionId])
  @@map("providers")
}

model ProviderPackage {
  id                 String  @id @default(cuid())
  providerId         String
  providerPlanId     String
  providerPlanCode   String?
  providerTemplateId String?
  providerStatus     String?
  name               String
  dataGB             Int
  validityDays       Int
  costPrice          Decimal
  currency           String  @default("USD")
  country            String?
  region             String?
  planType           String? /// PREMIUM | STANDARD | LIFETIME
  isAvailable        Boolean @default(true)
  readyToPublish     Boolean @default(false)

  // Pricing fields
  adminCostPrice     Decimal?
  effectiveCostPrice Decimal?
  costSource         String? /// PROVIDER | ADMIN_OVERRIDE | MISSING

  // Package management engine fields
  publishStatus          String?   @default("DRAFT") /// DRAFT | READY | PUBLISHED | HIDDEN | ARCHIVED
  configurationStatus    String?   @default("UNCONFIGURED") /// UNCONFIGURED | PARTIAL | CONFIGURED | AUTO_CONFIGURED
  sellingPrice           Decimal?
  sellingCurrency        String?   @default("USD")
  markupPercent          Decimal?
  pricingMode            String?   @default("MARKUP_PERCENT") /// MARKUP_PERCENT | FIXED_PRICE | FIXED_MARGIN
  autoConfiguredByRuleId String?
  lastConfiguredAt       DateTime?
  tags                   Json?
  notes                  String?

  // Normalization fields
  comparableKey          String?
  normalizedCountry      String?
  normalizedDataLabel    String?
  normalizedValidityDays Int?
  normalizedCoverageType String?

  // Cheapest ranking fields
  cheapestRank         Int?
  isCheapestCandidate  Boolean @default(false)
  cheapestReason       String?
  excludedFromCheapest Boolean @default(false)
  exclusionReason      String?

  // Preferred package & auto-pick fields
  isPreferred          Boolean   @default(false)
  preferredReason      String?
  preferredAt          DateTime?
  excludedFromAutoPick Boolean   @default(false)
  autoPickReason       String?

  // Phase 5C — Provider Cost Normalization
  costStatus           String?   @default("MISSING")
  costReceivedAt       DateTime?
  costExpiresAt        DateTime?
  isTaxInclusive       Boolean   @default(false)
  taxAmount            Decimal?
  costDerivationMethod String?
  costDerivationConfig Json?
  pricingStatus        String?   @default("COST_UNAVAILABLE")

  // Phase 3C — Active Price Snapshot
  activePriceSnapshotId String?               @unique
  activePriceSnapshot   PackagePriceSnapshot? @relation("ActivePriceSnapshot", fields: [activePriceSnapshotId], references: [id], onDelete: SetNull)

  providerRawData Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider         Provider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  publishedAs      ESIMPackage?
  configuredByRule PackageConfigurationRule? @relation("PackageAutoConfiguration", fields: [autoConfiguredByRuleId], references: [id], onDelete: SetNull)
  changeItems      CatalogChangeItem[]       @relation("PackageChangeItems")
  fees             ProviderPackageFee[]
  costSnapshots    ProviderCostSnapshot[]

  @@unique([providerId, providerPlanId])
  @@index([providerId])
  @@index([publishStatus])
  @@index([configurationStatus])
  @@map("provider_packages")
}

model PackageConfigurationRule {
  id              String   @id @default(cuid())
  name            String
  providerId      String?
  country         String?
  region          String?
  productType     String? /// NEW_ESIM | TOP_UP | BOTH
  dataMinGB       Int?
  dataMaxGB       Int?
  validityMinDays Int?
  validityMaxDays Int?
  costPrice       Decimal?
  markupPercent   Decimal?
  fixedPrice      Decimal?
  sellingCurrency String   @default("USD")
  publishStatus   String?  @default("READY")
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider           Provider?         @relation("ProviderConfigurationRules", fields: [providerId], references: [id], onDelete: SetNull)
  configuredPackages ProviderPackage[] @relation("PackageAutoConfiguration")
  executions         RuleExecution[]   @relation("RuleToExecution")

  @@index([providerId])
  @@index([priority])
  @@index([isActive])
  @@map("package_configuration_rules")
}

model RuleExecution {
  id           String    @id @default(cuid())
  ruleId       String
  ruleName     String
  executedById String?
  executedAt   DateTime  @default(now())
  startedAt    DateTime
  finishedAt   DateTime?
  durationMs   Int?
  scope        String
  filtersUsed  Json?
  totalMatched Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  failedCount  Int       @default(0)
  skipDetails  Json?
  status       String    @default("PENDING") /// PENDING | RUNNING | COMPLETED | FAILED | CANCELLED

  rule       PackageConfigurationRule @relation("RuleToExecution", fields: [ruleId], references: [id], onDelete: Cascade)
  executedBy User?                    @relation("UserRuleExecutions", fields: [executedById], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([executedAt])
  @@index([status])
  @@map("rule_executions")
}

model CatalogChangeSet {
  id           String   @id @default(cuid())
  actionType   String
  description  String?
  createdById  String?
  createdAt    DateTime @default(now())
  totalChanged Int      @default(0)
  metadata     Json?

  createdBy User?               @relation("UserChangeSets", fields: [createdById], references: [id], onDelete: SetNull)
  items     CatalogChangeItem[]

  @@map("catalog_change_sets")
}

model CatalogChangeItem {
  id                String   @id @default(cuid())
  changeSetId       String
  providerPackageId String
  before            Json
  after             Json
  createdAt         DateTime @default(now())

  changeSet CatalogChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  pkg       ProviderPackage  @relation("PackageChangeItems", fields: [providerPackageId], references: [id], onDelete: Cascade)

  @@map("catalog_change_items")
}

model ESIMPackage {
  id                        String        @id @default(cuid())
  name                      String
  displayName               String?
  description               String?
  customerDescription       String?
  dataGB                    Int
  validityDays              Int
  priceUSD                  Decimal
  localPrice                Decimal
  currency                  String        @default("USD")
  isActive                  Boolean       @default(true)
  sku                       String?       @unique
  packageCode               String?       @unique
  providerName              String?
  providerPlanId            String?
  providerId                String?
  providerRawData           Json?
  costPriceUSD              Decimal?
  costCurrency              String?       @default("USD")
  markupPercent             Decimal?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  source                    PackageSource @default(CATALOG_PRODUCT)
  providerMapping           Json?
  productType               ProductType   @default(NEW_ESIM)
  topUpQuantity             Int?
  topUpDays                 Int?
  topUpOccurrences          Int?
  compatibleTopUpPackageIds Json?
  archivedAt                DateTime?
  hiddenFromCatalog         Boolean       @default(false)
  providerPackageId         String?       @unique

  purchases       ESIMPurchase[]
  provider        Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerPackage ProviderPackage? @relation(fields: [providerPackageId], references: [id], onDelete: SetNull)
  pricingRules    PricingRule[]
  topUpRecords    ESIMTopUp[]

  @@map("esim_packages")
}

model ESIMPurchase {
  id                    String    @id @default(cuid())
  businessId            String
  userId                String
  packageId             String
  quantity              Int
  totalAmount           Decimal
  status                String    @default("PENDING")
  providerStatus        String?
  providerResponse      Json?
  callbackUrl           String?
  packageSnapshot       Json?
  packageName           String?
  packageDataGB         Int?
  packageValidityDays   Int?
  packageUnitPrice      Decimal?
  packageCurrency       String?
  /// State machine fields
  previousStatus        String?
  statusChangedAt       DateTime?
  failureReason         String?
  providerErrorCode     String?
  providerErrorMessage  String?
  /// Provider dispatch fields
  providerId            String?
  providerReservationId String?
  providerFulfillId     String?
  /// Idempotency key for duplicate prevention
  providerPurchaseKey   String?   @unique
  /// Retry fields
  retryCount            Int       @default(0)
  maxRetries            Int       @default(3)
  nextRetryAt           DateTime?
  lastRetryAt           DateTime?
  retryReason           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package            ESIMPackage          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  esims              ESIM[]
  invoice            Invoice?
  events             OrderTimelineEvent[]
  provider           Provider?            @relation(fields: [providerId], references: [id], onDelete: SetNull)
  walletTransactions WalletTransaction[]
  billingRecords     BillingRecord[]      @relation("BillingRecordOrder")

  @@map("esim_purchases")
}

model OrderTimelineEvent {
  id          String   @id @default(cuid())
  orderId     String
  eventType   String
  oldStatus   String?
  newStatus   String?
  message     String?
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  order     ESIMPurchase @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id])

  @@index([orderId, createdAt])
  @@map("order_timeline_events")
}

model ESIM {
  id                     String    @id @default(cuid())
  purchaseId             String
  customerId             String?
  iccid                  String    @unique
  imsi                   String?
  activationCode         String?
  qrCodeUrl              String?
  status                 String    @default("PENDING")
  activatedAt            DateTime?
  expiresAt              DateTime?
  deliveryStatus         String    @default("NOT_SENT")
  deliveredAt            DateTime?
  providerActivationId   String?
  providerSubscriptionId String?
  providerStatus         String?
  providerResponse       Json?
  lastSyncAt             DateTime?
  dataUsedMB             Int       @default(0)
  dataRemainingMB        Int?
  dataTotalMB            Int?
  lastUsageAt            DateTime?
  activationDetectedAt   DateTime?
  lastUsageSyncAt        DateTime?
  lastStatusSyncAt       DateTime?
  sharedAt               DateTime?
  sharedToEmail          String?
  packageSnapshot        Json?
  packageName            String?
  packageDataGB          Int?
  packageValidityDays    Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  purchase       ESIMPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  usageRecords   UsageRecord[]
  usageSessions  UsageSession[]
  usageAlerts    UsageAlert[]
  topUps         ESIMTopUp[]      @relation("ESIMTopUps")
  shareTokens    ESIMShareToken[]
  billingRecords BillingRecord[]  @relation("BillingRecordESIM")

  @@map("esims")
}

model ESIMTopUp {
  id                String          @id @default(cuid())
  businessId        String
  esimId            String
  customerId        String?
  packageId         String
  providerId        String?
  providerReference String?
  amount            Decimal
  currency          String          @default("USD")
  status            ESIMTopUpStatus @default(PENDING)
  dataAddedMB       Int?
  validityDaysAdded Int?
  providerResponse  Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  business Business    @relation("BusinessESIMTopUps", fields: [businessId], references: [id], onDelete: Cascade)
  esim     ESIM        @relation("ESIMTopUps", fields: [esimId], references: [id], onDelete: Restrict)
  package  ESIMPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  Invoice  Invoice?
  customer Customer?   @relation(fields: [customerId], references: [id])

  @@map("esim_top_ups")
}

model UsageRecord {
  id              String   @id @default(cuid())
  esimId          String
  dataUsedMB      Int
  dataTotalMB     Int?
  dataRemainingMB Int?
  dataPercentage  Float?
  timestamp       DateTime @default(now())
  rawData         Json?

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId, timestamp])
  @@map("usage_records")
}

model UsageSession {
  id          String    @id @default(cuid())
  esimId      String
  sessionId   String?
  startTime   DateTime
  endTime     DateTime?
  durationSec Int?
  dataUsedMB  Int?
  country     String?
  operator    String?
  network     String?
  cost        Decimal?
  currency    String?
  rawData     Json?
  createdAt   DateTime  @default(now())

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId, startTime])
  @@map("usage_sessions")
}

model UsageAlert {
  id             String    @id @default(cuid())
  esimId         String
  alertType      String /// USAGE_80 | USAGE_90 | USAGE_100 | NO_ACTIVITY | LOW_WALLET | USAGE_SPIKE
  severity       String /// INFO | WARNING | CRITICAL
  message        String
  details        Json?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId, createdAt])
  @@map("usage_alerts")
}

model ESIMShareToken {
  id          String    @id @default(cuid())
  esimId      String
  token       String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@map("esim_share_tokens")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String?
  businessId    String
  purchaseId    String?
  topUpId       String?
  type          String    @default("MANUAL")
  amount        Decimal
  subtotal      Decimal?
  taxTotal      Decimal?  @default(0)
  currency      String    @default("USD")
  status        String    @default("DRAFT")
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase       ESIMPurchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  topUp          ESIMTopUp?        @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]
  billingRecords BillingRecord[]

  @@unique([purchaseId])
  @@unique([topUpId])
  @@map("invoices")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  businessId  String
  orderId     String?
  amount      Decimal
  type        String
  description String?
  createdAt   DateTime @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    ESIMPurchase? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("wallet_transactions")
}

model BillingRecord {
  id            String   @id @default(cuid())
  businessId    String
  orderId       String?
  esimId        String?
  invoiceId     String?
  type          String /// PURCHASE | TOPUP | REFUND | CREDIT | DEBIT | COST_ADJUSTMENT
  amount        Decimal
  cost          Decimal? /// provider cost (nullable for non-purchases)
  marginAmount  Decimal? /// amount - cost
  marginPercent Float? /// (margin/amount) * 100
  currency      String   @default("USD")
  providerId    String?
  salesAgentId  String?
  status        String   @default("COMPLETED")
  description   String?
  createdAt     DateTime @default(now())

  business   Business       @relation("BillingRecordBusiness", fields: [businessId], references: [id])
  order      ESIMPurchase?  @relation("BillingRecordOrder", fields: [orderId], references: [id], onDelete: SetNull)
  esim       ESIM?          @relation("BillingRecordESIM", fields: [esimId], references: [id], onDelete: SetNull)
  invoice    Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider   Provider?      @relation("BillingRecordProvider", fields: [providerId], references: [id], onDelete: SetNull)
  salesAgent InternalAdmin? @relation("BillingRecordSalesAgent", fields: [salesAgentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([providerId, createdAt])
  @@index([salesAgentId, createdAt])
  @@map("billing_records")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal
  totalPrice  Decimal
  taxRate     Decimal? @default(0)
  taxAmount   Decimal? @default(0)
  type        String? /// PURCHASE | TOPUP | REFUND | CREDIT | ADJUSTMENT
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

enum TopUpRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  MANUAL
  GATEWAY
}

enum ESIMTopUpStatus {
  PENDING
  COMPLETED
  FAILED
}

model WalletTopUpRequest {
  id               String             @id @default(cuid())
  businessId       String
