generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INTERNAL_ADMIN
  BUSINESS_USER
}

enum BusinessStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BusinessUserRole {
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum InternalAdminRole {
  ADMIN
  SUPER_ADMIN
  OPERATIONS_MANAGER
  PRODUCT_MANAGER
  SUPPORT_MANAGER
  SUPPORT_AGENT
  ANALYTICS_MANAGER
  FINANCE_MANAGER
  READ_ONLY
}

enum PackageSource {
  PROVIDER_PLAN
  CATALOG_PRODUCT
  MANUAL
}

enum ProductType {
  NEW_ESIM
  TOP_UP
  BOTH
}

enum ProviderType {
  /// Legacy — use CUSTOM for all new providers
  IBASIS
  /// Legacy — use CUSTOM for all new providers
  CHOICE
  MOCK
  CUSTOM
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  MAINTENANCE
  INACTIVE
  TESTING
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessUsers         BusinessUser[]
  internalAdmin         InternalAdmin?
  purchases             ESIMPurchase[]
  topUpRequests         WalletTopUpRequest[] @relation("TopUpRequestedBy")
  approvedTopUpRequests WalletTopUpRequest[] @relation("TopUpApprovedBy")
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
  createdTickets        SupportTicket[]      @relation("TicketCreator")
  assignedTickets       SupportTicket[]      @relation("TicketAssignee")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  type      String    @default("SET_PASSWORD") // SET_PASSWORD | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("password_reset_tokens")
}

model Business {
  id            String         @id @default(cuid())
  name          String
  regNumber     String?
  taxId         String?
  contactEmail  String
  contactPhone  String?
  address       String?
  country       String
  status        BusinessStatus @default(PENDING)
  walletBalance Decimal        @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users              BusinessUser[]
  purchases          ESIMPurchase[]
  invoices           Invoice[]
  transactions       WalletTransaction[]
  topUpRequests      WalletTopUpRequest[]
  esimTopUps         ESIMTopUp[]               @relation("BusinessESIMTopUps")
  supportTickets     SupportTicket[]
  customers          Customer[]
  apiKeys            BusinessApiKey[]
  webhookEndpoints   BusinessWebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]
  apiRequestLogs     ApiRequestLog[]
  rateLimitPerMinute Int?
  pricingRules       PricingRule[]

  @@map("businesses")
}

model BusinessUser {
  id         String           @id @default(cuid())
  userId     String
  businessId String
  role       BusinessUserRole @default(MEMBER)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("business_users")
}

model InternalAdmin {
  id          String            @id @default(cuid())
  userId      String            @unique
  role        InternalAdminRole @default(ADMIN)
  permissions Json?
  isActive    Boolean           @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("internal_admins")
}

model Provider {
  id                       String         @id @default(cuid())
  name                     String
  code                     String         @unique
  type                     ProviderType
  adapterStrategy          String?
  authType                 String?        @default("bearer_token")
  apiVersion               String?        @default("v1")
  apiBaseUrl               String?
  authUrl                  String?
  apiToken                 String?
  tokenPlacement           String?        @default("URL_PATH")
  planListPath             String?
  activationPath           String?
  statusPath               String?
  usagePath                String?
  suspendPath              String?
  resumePath               String?
  topUpPath                String?
  responseListKey          String?
  environment              String         @default("staging")
  status                   ProviderStatus @default(ACTIVE)
  priority                 Int            @default(0)
  isDefaultFallback        Boolean        @default(false)
  regions                  Json? /// Array of supported region/country codes for routing
  supportsESIM             Boolean        @default(true)
  supportsUsage            Boolean        @default(false)
  supportsTopUp            Boolean        @default(false)
  supportsSuspend          Boolean        @default(false)
  supportsQRCode           Boolean        @default(false)
  supportsPools            Boolean        @default(false)
  supportsTemplates        Boolean        @default(false)
  supportsUsageSync        Boolean        @default(false)
  supportsWebhookPush      Boolean        @default(false)
  supportsSuspendResume    Boolean        @default(false)
  endpointMappings         Json?
  fieldMappings            Json?
  config                   Json?
  /// Health tracking fields
  lastSuccessfulConnection DateTime?
  lastFailedConnection     DateTime?
  activationSuccessRate    Float? /// Percentage 0-100
  averageActivationTimeMs  Int?
  errorCount               Int?           @default(0)
  lastError                String? /// Last error message
  lastSyncAt               DateTime? /// Last successful plan sync
  lastSyncResult           String? /// Summary of last sync result
  lastSyncCount            Int? /// Number of plans fetched in last sync
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  packages        ESIMPackage[]
  healthSnapshots ProviderHealthSnapshot[]

  @@map("providers")
}

model ESIMPackage {
  id                        String        @id @default(cuid())
  name                      String
  displayName               String?
  description               String?
  customerDescription       String?
  dataGB                    Int
  validityDays              Int
  priceUSD                  Decimal
  localPrice                Decimal
  currency                  String        @default("USD")
  isActive                  Boolean       @default(true)
  sku                       String?       @unique
  packageCode               String?       @unique
  providerName              String?
  providerPlanId            String?
  providerId                String?
  providerRawData           Json?
  costPriceUSD              Decimal?
  markupPercent             Decimal?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  source                    PackageSource @default(CATALOG_PRODUCT)
  providerMapping           Json?
  productType               ProductType   @default(NEW_ESIM)
  topUpQuantity             Int?
  topUpDays                 Int?
  topUpOccurrences          Int?
  compatibleTopUpPackageIds Json?
  archivedAt                DateTime?
  hiddenFromCatalog         Boolean       @default(false)

  purchases    ESIMPurchase[]
  provider     Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  pricingRules PricingRule[]
  topUpRecords ESIMTopUp[]

  @@map("esim_packages")
}

model ESIMPurchase {
  id                  String   @id @default(cuid())
  businessId          String
  userId              String
  packageId           String
  quantity            Int
  totalAmount         Decimal
  status              String   @default("PENDING")
  providerStatus      String?
  providerResponse    Json?
  callbackUrl         String?
  packageSnapshot     Json?
  packageName         String?
  packageDataGB       Int?
  packageValidityDays Int?
  packageUnitPrice    Decimal?
  packageCurrency     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  ESIMPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  esims    ESIM[]
  invoice  Invoice?

  @@map("esim_purchases")
}

model ESIM {
  id                     String    @id @default(cuid())
  purchaseId             String
  customerId             String?
  iccid                  String    @unique
  imsi                   String?
  activationCode         String?
  qrCodeUrl              String?
  status                 String    @default("PENDING")
  activatedAt            DateTime?
  expiresAt              DateTime?
  deliveryStatus         String    @default("NOT_SENT")
  deliveredAt            DateTime?
  providerActivationId   String?
  providerSubscriptionId String?
  providerStatus         String?
  providerResponse       Json?
  lastSyncAt             DateTime?
  dataUsedMB             Int       @default(0)
  dataRemainingMB        Int?
  dataTotalMB            Int?
  lastUsageAt            DateTime?
  activationDetectedAt   DateTime?
  lastUsageSyncAt        DateTime?
  lastStatusSyncAt       DateTime?
  sharedAt               DateTime?
  sharedToEmail          String?
  packageSnapshot        Json?
  packageName            String?
  packageDataGB          Int?
  packageValidityDays    Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  purchase     ESIMPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  usageRecords UsageRecord[]
  topUps       ESIMTopUp[]      @relation("ESIMTopUps")
  shareTokens  ESIMShareToken[]

  @@map("esims")
}

model ESIMTopUp {
  id                String          @id @default(cuid())
  businessId        String
  esimId            String
  customerId        String?
  packageId         String
  providerId        String?
  providerReference String?
  amount            Decimal
  currency          String          @default("USD")
  status            ESIMTopUpStatus @default(PENDING)
  dataAddedMB       Int?
  validityDaysAdded Int?
  providerResponse  Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  business Business    @relation("BusinessESIMTopUps", fields: [businessId], references: [id], onDelete: Cascade)
  esim     ESIM        @relation("ESIMTopUps", fields: [esimId], references: [id], onDelete: Restrict)
  package  ESIMPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  Invoice  Invoice?
  customer Customer?   @relation(fields: [customerId], references: [id])

  @@map("esim_top_ups")
}

model UsageRecord {
  id              String   @id @default(cuid())
  esimId          String
  dataUsedMB      Int
  dataTotalMB     Int?
  dataRemainingMB Int?
  timestamp       DateTime @default(now())

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model ESIMShareToken {
  id          String    @id @default(cuid())
  esimId      String
  token       String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  esim ESIM @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@map("esim_share_tokens")
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String?
  businessId    String
  purchaseId    String?
  topUpId       String?
  type          String    @default("MANUAL")
  amount        Decimal
  currency      String    @default("USD")
  status        String    @default("DRAFT")
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase ESIMPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  topUp    ESIMTopUp?    @relation(fields: [topUpId], references: [id], onDelete: SetNull)

  @@unique([purchaseId])
  @@unique([topUpId])
  @@map("invoices")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  businessId  String
  amount      Decimal
  type        String
  description String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

enum TopUpRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  MANUAL
  GATEWAY
}

enum ESIMTopUpStatus {
  PENDING
  COMPLETED
  FAILED
}

model WalletTopUpRequest {
  id               String             @id @default(cuid())
  businessId       String
  requestedById    String
  amount           Decimal
  currency         String             @default("USD")
  status           TopUpRequestStatus @default(PENDING)
  paymentReference String             @unique
  paymentMethod    PaymentMethod      @default(MANUAL)
  gatewayProvider  String?
  gatewayReference String?
  proofUrl         String?
  adminNote        String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("TopUpRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("TopUpApprovedBy", fields: [approvedById], references: [id])

  @@map("wallet_top_up_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Customer {
  id         String         @id @default(cuid())
  businessId String
  name       String
  email      String
  phone      String?
  country    String
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  esims      ESIM[]
  esimTopUps ESIMTopUp[]

  @@map("customers")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AnnualMarkupSetting {
  id            String   @id @default(cuid())
  year          Int      @unique
  markupPercent Decimal
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("annual_markup_settings")
}

model PricingRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  ruleType    String    @default("GLOBAL_DISCOUNT") // GLOBAL_DISCOUNT | BUSINESS_DISCOUNT | REGION_OVERRIDE | PACKAGE_OVERRIDE | PROMOTIONAL
  ruleMode    String    @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT | FIXED_PRICE
  value       Decimal? // percentage, amount, or fixed price
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  businessId  String?
  region      String?
  country     String?
  packageId   String?
  packageType String?
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  package  ESIMPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@map("pricing_rules")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model BusinessApiKey {
  id         String       @id @default(cuid())
  businessId String
  name       String
  keyHash    String
  keyPrefix  String       @unique
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_api_keys")
}

model IdempotencyRecord {
  id         String   @id @default(cuid())
  key        String   @unique
  businessId String
  response   Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("idempotency_records")
}

enum WebhookEndpointStatus {
  ACTIVE
  INACTIVE
}

model BusinessWebhookEndpoint {
  id            String                @id @default(cuid())
  businessId    String
  name          String
  url           String
  secret        String
  status        WebhookEndpointStatus @default(ACTIVE)
  events        Json
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([businessId])
  @@map("business_webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  businessId   String
  endpointId   String
  eventType    String
  eventId      String?
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  responseBody String?
  errorMessage String?
  attempts     Int                   @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime              @default(now())
  sentAt       DateTime?

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endpoint BusinessWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([endpointId])
  @@index([status])
  @@index([eventType])
  @@map("webhook_deliveries")
}

enum JobType {
  ACTIVATION_SYNC
  WEBHOOK_DELIVERY
  USAGE_SYNC
  EMAIL_DELIVERY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@map("background_jobs")
}

model ApiRequestLog {
  id             String   @id @default(cuid())
  businessId     String
  apiKeyId       String?
  method         String
  path           String
  statusCode     Int
  durationMs     Int
  ipAddress      String?
  userAgent      String?
  idempotencyKey String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([apiKeyId])
  @@index([path])
  @@index([statusCode])
  @@index([createdAt])
  @@map("api_request_logs")
}

model ProviderWebhookEvent {
  id              String    @id @default(cuid())
  providerId      String?
  providerType    String
  eventType       String
  externalEventId String?
  iccid           String?
  imsi            String?
  esimId          String?
  businessId      String?
  status          String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  payload         Json
  errorMessage    String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([providerType, externalEventId])
  @@index([providerType])
  @@index([eventType])
  @@index([iccid])
  @@index([imsi])
  @@index([esimId])
  @@index([businessId])
  @@index([status])
  @@index([receivedAt])
  @@map("provider_webhook_events")
}

model ProviderHealthSnapshot {
  id                  String   @id @default(cuid())
  providerId          String
  status              String   @default("HEALTHY") // HEALTHY | DEGRADED | DOWN
  responseTimeMs      Int?
  successRate         Float?
  lastCheckAt         DateTime
  failureCount        Int      @default(0)
  consecutiveFailures Int      @default(0)
  metadata            Json?
  createdAt           DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("provider_health_snapshots")
}

model ProviderFailoverEvent {
  id                 String   @id @default(cuid())
  originalProviderId String?
  fallbackProviderId String?
  packageId          String?
  orderId            String?
  reason             String
  createdAt          DateTime @default(now())

  @@index([originalProviderId])
  @@index([fallbackProviderId])
  @@index([createdAt])
  @@map("provider_failover_events")
}

model SupportTicket {
  id               String    @id @default(cuid())
  ticketNumber     String    @unique
  businessId       String
  createdById      String
  assignedToId     String?
  subject          String
  category         String    @default("GENERAL") // TECHNICAL | BILLING | WALLET | API | ESIM_ACTIVATION | TOPUP | GENERAL
  priority         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status           String    @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  relatedEsimId    String?
  relatedOrderId   String?
  relatedInvoiceId String?
  lastMessageAt    DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?                @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   SupportMessage[]
  events     SupportTicketEvent[]

  @@index([businessId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id            String    @id @default(cuid())
  ticketId      String
  senderId      String
  senderType    String    @default("BUSINESS_USER") // BUSINESS_USER | ADMIN | SYSTEM
  message       String
  attachmentUrl String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportTypingState {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  isTyping  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([ticketId, userId])
  @@map("support_typing_states")
}

model SupportTicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String?
  eventType String // TICKET_CREATED | MESSAGE_SENT | STATUS_CHANGED | ASSIGNED | PRIORITY_CHANGED | TICKET_CLOSED | TICKET_REOPENED | READ_RECEIPT
  metadata  Json?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_events")
}

// ─── No-Code Provider Connector (Phase 1) ──────────────────────────

model ProviderConfig {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  baseUrl       String   @map("base_url")
  authType      String   @map("auth_type")
  /// AES-256-GCM encrypted JSON blob
  credentials   String
  adapterClass  String   @default("rest_generic") @map("adapter_class")
  fieldMappings Json     @default("{}") @map("field_mappings")
  endpoints     Json     @default("{}")
  webhookConfig Json     @default("{}") @map("webhook_config")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("provider_configs")
}

model ProviderTemplate {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  connectorType          String   @default("STANDARD")
  authType               String   @default("bearer_token")
  tokenPlacement         String   @default("URL_PATH")
  defaultBaseUrl         String?
  defaultAuthUrl         String?
  defaultPlanListPath    String?
  defaultActivationPath  String?
  defaultStatusPath      String?
  defaultUsagePath       String?
  defaultSuspendPath     String?
  defaultResumePath      String?
  defaultResponseListKey String?
  defaultFieldMappings   Json     @default("{}")
  defaultCapabilities    Json     @default("{}")
  isSystemTemplate       Boolean  @default(false)
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("provider_templates")
}
