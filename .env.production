# =============================================================================
# OneSim Africa – Production Environment
# Target: m2m.onetelecom.cloud
# =============================================================================
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Replace placeholders after running scripts/setup-production-db.sh
DATABASE_URL="postgresql://onesim_prod:YOUR_GENERATED_PASSWORD@localhost:5432/onesim_production"

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://m2m.onetelecom.cloud

# ── App / NextAuth ────────────────────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXT_PUBLIC_APP_URL="https://m2m.onetelecom.cloud"
NEXTAUTH_URL="https://m2m.onetelecom.cloud"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Encryption (for provider API tokens) ─────────────────────────────────────
# Generate with: openssl enc -aes-256-cbc -k secret -P -md sha1 | grep iv | cut -d= -f2 | tr -d ' '
ENCRYPTION_SECRET="generate-with-openssl-rand-base64-32"

# ── Cron / Webhook Security ──────────────────────────────────────────────────
# Used by provider health cron and webhook verification
CRON_SECRET="generate-a-separate-random-string"

# ── Provider Base URLs (staging → production overrides) ──────────────────────
# These should match the provider's production environment
# Configured per-provider in the admin UI, but can be set here as defaults
# AIRHUB_BASE_URL="https://api.airhub.com/v1"
# RAKUTEN_BASE_URL="https://api-partner-prepaid-sim.mobile.rakuten.com/v1/esim"
# CHOICE_BASE_URL="https://production.choice.com/api"
