# Auto detect text files and normalize to LF
* text=auto

# Ensure consistent LF endings for these extensions
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files - leave as-is
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
