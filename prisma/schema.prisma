  ruleConfig        Json?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  template        PV2Template?        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion PV2TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  operation       PV2Operation?       @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@unique([templateId, ruleCode])
  @@index([templateId])
  @@index([templateVersionId])
  @@index([severity])
  @@index([phase])
  @@index([category])
  @@map("pv2_template_validation_rules")
}

// ══════════════════════════════════════════════════════════════════════
// CATALOG REVIEW & APPROVAL CENTER — Phase 3C
// ══════════════════════════════════════════════════════════════════════

enum PipelineRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReviewItemStatus {
  PENDING
  APPROVED
  REJECTED
  IGNORED
  APPLIED
  FAILED
}

model PipelineRun {
  id                     String            @id @default(cuid())
  idempotencyKey         String?           @unique
  trigger                String            @default("MANUAL") // MANUAL / PROVIDER_SYNC / SCHEDULED
  status                 PipelineRunStatus @default(RUNNING)
  totalPackages          Int               @default(0)
  newPackages            Int               @default(0)
  updatedPackages        Int               @default(0)
  readyForReview         Int               @default(0)
  needsAttention         Int               @default(0)
  unchanged              Int               @default(0)
  estimatedRevenueImpact Float?
  estimatedProfitImpact  Float?
  currency               String            @default("USD")
  startedAt              DateTime          @default(now())
  finishedAt             DateTime?
  createdById            String?
  createdAt              DateTime          @default(now())

  reviewItems CatalogReviewItem[]

  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("pipeline_runs")
}

model CatalogReviewItem {
  id            String      @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  packageId    String
  packageName  String
  providerId   String?
  providerName String?

  // Classification
  classification  String // NEW / UPDATED / READY_FOR_REVIEW / NEEDS_ATTENTION / UNCHANGED
  processingState String // DETECTED / ANALYZED / SIMULATED / OPTIMIZED / READY_FOR_REVIEW

  // Pricing
  currentSellingPrice   Float?
  proposedSellingPrice  Float?
  currentMarginPercent  Float?
  proposedMarginPercent Float?

  // Provider
  currentProviderId       String?
  currentProviderName     String?
  recommendedProviderId   String?
  recommendedProviderName String?
  costDifference          Float?
  profitDifference        Float?

  // Recommendation
  suggestedAction String // CONFIGURE / REVIEW_PRICING / SWITCH_PROVIDER / ARCHIVE
  confidence      Int     @default(0)
  reason          String?

  // Decision
  reviewStatus ReviewItemStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  decision     String?
  applyResult  String? // success reason or failure details
  isStale      Boolean          @default(false)
  staleReason  String?

  // Audit
  beforeSnapshot Json? // snapshot of values before decision
  afterSnapshot  Json? // snapshot of values after application
  changes        Json? // detected field changes
  warnings       Json? // validation warnings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineRunId, packageId])
  @@index([pipelineRunId])
  @@index([packageId])
  @@index([reviewStatus])
  @@index([reviewedAt])
  @@index([providerId])
  @@map("catalog_review_items")
}

// ══════════════════════════════════════════════════════════════════════
// PROVIDER WALLET — Phase 5C
// ══════════════════════════════════════════════════════════════════════

model ProviderWallet {
  id                  String    @id @default(cuid())
  providerId          String    @unique
  balance             Float     @default(0)
  currency            String    @default("USD")
  available           String?
  lastSyncedAt        DateTime?
  syncStatus          String?   @default("OK")
  lastError           String?
  lowBalanceThreshold Float?    @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  snapshots ProviderWalletSnapshot[]

  @@index([providerId])
  @@map("provider_wallets")
}

model ProviderWalletSnapshot {
  id         String   @id @default(cuid())
  walletId   String
  balance    Float    @default(0)
  currency   String   @default("USD")
  available  String?
  snapshotAt DateTime @default(now())

  wallet ProviderWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, snapshotAt])
  @@map("provider_wallet_snapshots")
}

model ProviderWalletTransaction {
  id                String   @id @default(cuid())
  providerId        String
  fingerprint       String   @unique
  providerReference String?
  orderId           String?
  transactionType   String   // CREDIT | DEBIT | PURCHASE | REFUND | ADJUSTMENT | UNKNOWN
  amount            Float
  currency          String   @default("USD")
  balanceBefore     Float?
  balanceAfter      Float?
  runningBalance    Float?
  occurredAt        DateTime
  description       String?
  createdAt         DateTime @default(now())

  @@index([providerId, occurredAt])
  @@index([fingerprint])
  @@map("provider_wallet_transactions")
}

// ══════════════════════════════════════════════════════════════════
// PROVIDER COST NORMALIZATION — Phase 5C
// ══════════════════════════════════════════════════════════════════

model ProviderPackageFee {
  id                String   @id @default(cuid())
  providerPackageId String
  type              String // ACTIVATION | TRANSACTION | RECURRING | RENEWAL | TAX | OTHER
  amount            Decimal
  currency          String   @default("USD")
  chargeTiming      String // AT_PURCHASE | AT_ACTIVATION | MONTHLY | AT_RENEWAL | PROVIDER_INCLUDED
  label             String?
  createdAt         DateTime @default(now())

  providerPackage ProviderPackage @relation(fields: [providerPackageId], references: [id], onDelete: Cascade)

  @@index([providerPackageId])
  @@map("provider_package_fees")
}

model ProviderCostSnapshot {
  id                  String    @id @default(cuid())
  providerPackageId   String
  originalAmount      Decimal
  originalCurrency    String    @default("USD")
  normalizedAmount    Decimal
  normalizedCurrency  String    @default("USD")
  costSource          String // PROVIDER_COST | PROVIDER_WHOLESALE | PROVIDER_NET_PRICE | DERIVED_FROM_COMMISSION | DERIVED_FROM_DISCOUNT | ADMIN_OVERRIDE
  exchangeRate        Decimal?
  exchangeRateSource  String?
  exchangeRateVersion String?
  isTaxInclusive      Boolean   @default(false)
  taxAmount           Decimal?
  feesSnapshot        Json? // serialized fee array at snapshot time
  receivedAt          DateTime
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  metadata            Json?

  providerPackage ProviderPackage @relation(fields: [providerPackageId], references: [id], onDelete: Cascade)

  @@index([providerPackageId, createdAt])
  @@map("provider_cost_snapshots")
}

// ══════════════════════════════════════════════════════════════════
// PHASE 3 — EXCHANGE RATES, PRICE SNAPSHOTS, PURCHASE QUOTES
// ══════════════════════════════════════════════════════════════════

enum ExchangeRateSource {
  MANUAL
  PROVIDER
  EXTERNAL_API
  SYSTEM
}

enum ExchangeRateStatus {
  ACTIVE
  STALE
  DISABLED
  INVALID
}

enum PurchaseQuoteStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  INVALIDATED
  CANCELLED
}

model ExchangeRate {
  id            String             @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal            @db.Decimal(24, 12)
  source        ExchangeRateSource
  status        ExchangeRateStatus @default(ACTIVE)
  effectiveAt   DateTime
  expiresAt     DateTime?
  fetchedAt     DateTime           @default(now())
  version       Int                @default(1)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([baseCurrency, quoteCurrency, effectiveAt])
  @@index([baseCurrency, quoteCurrency, status])
  @@index([expiresAt])
  @@map("exchange_rates")
}

model PackagePriceSnapshot {
  id                String  @id @default(cuid())
  providerPackageId String
  businessId        String?

  originalCostAmount   Decimal @db.Decimal(18, 6)
  originalCostCurrency String

  effectiveCostAmount   Decimal @db.Decimal(18, 6)
  effectiveCostCurrency String

  baseSellingPrice  Decimal @db.Decimal(18, 6)
  finalSellingPrice Decimal @db.Decimal(18, 6)
  sellingCurrency   String

  profitAmount  Decimal @db.Decimal(18, 6)
  marginPercent Decimal @db.Decimal(10, 4)

  providerCostSnapshotId String?
  exchangeRateId         String?
  exchangeRateVersion    Int?

  pricingEngineVersion String

  reason String
  status String @default("ACTIVE")

  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  metadata    Json?

  // Reverse relation: packages using this as active snapshot
  activeForPackage ProviderPackage? @relation("ActivePriceSnapshot")

  @@index([providerPackageId, createdAt])
  @@index([status])
  @@map("package_price_snapshots")
}

model PurchaseQuote {
  id             String @id @default(cuid())
  quoteReference String @unique

  providerPackageId      String
  packagePriceSnapshotId String

  businessId String
  customerId String?

  quantity Int @default(1)

  unitPrice   Decimal @db.Decimal(18, 6)
  totalAmount Decimal @db.Decimal(18, 6)
  currency    String

  effectiveCostAmount   Decimal @db.Decimal(18, 6)
  effectiveCostCurrency String

  providerCostSnapshotId String?
  exchangeRateId         String?
  exchangeRateVersion    Int?

  pricingEngineVersion String

  status PurchaseQuoteStatus @default(ACTIVE)

  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?

  idempotencyKey String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([providerPackageId])
  @@index([expiresAt])
  @@map("purchase_quotes")
}

model SystemJobLock {
  id          String   @id @default(cuid())
  jobName     String   @unique
  lockedAt    DateTime
  lockedUntil DateTime
  owner       String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_job_locks")
}
