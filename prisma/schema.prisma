  providers       Provider[]
  endpoints       PV2TemplateEndpoint[]
  fieldMappings   PV2TemplateFieldMapping[]
  transformations PV2TemplateTransformation[]
  errorMappings   PV2TemplateErrorMapping[]
  webhookConfigs  PV2TemplateWebhookConfig[]
  syncConfigs     PV2TemplateSyncConfig[]
  pipelineConfigs PV2TemplatePipelineConfig[]
  validationRules PV2TemplateValidationRule[]
  healthChecks    PV2TemplateHealthCheck[]

  @@unique([templateId, version])
  @@unique([templateId, semanticVersion])
  @@index([templateId])
  @@index([status])
  @@map("pv2_template_versions")
}

model PV2TemplateFeaturePack {
