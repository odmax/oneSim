}

// ══════════════════════════════════════════════════════════════════════
// PROVIDER FRAMEWORK V2 — RETRY, RATE LIMIT & CACHE POLICIES
// ══════════════════════════════════════════════════════════════════════

model PV2TemplateRetryPolicy {
  id                  String             @id @default(cuid())
  templateId          String
  code                String
  name                String?
  maxAttempts         Int                @default(3)
  initialDelayMs      Int                @default(1000)
  maxDelayMs          Int                @default(30000)
  backoffStrategy     PV2BackoffStrategy @default(EXPONENTIAL)
  multiplier          Float              @default(2.0)
  jitter              Boolean            @default(true)
  retryableStatuses   Json?
  retryableErrorTypes Json?
  idempotentOnly      Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  template  PV2Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  endpoints PV2TemplateEndpoint[]

  @@unique([templateId, code])
  @@index([templateId])
  @@map("pv2_template_retry_policies")
}

model PV2TemplateRateLimitPolicy {
  id                     String   @id @default(cuid())
  templateId             String   @unique
  requestsPerSecond      Int      @default(10)
  requestsPerMinute      Int      @default(600)
  requestsPerHour        Int      @default(36000)
  concurrentLimit        Int      @default(10)
  burstLimit             Int      @default(20)
  providerHeaderMappings Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  template PV2Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("pv2_template_rate_limit_policies")
}

model PV2TemplateCachePolicy {
  id                     String        @id @default(cuid())
