  @@map("pv2_template_auth_response_mappings")
}

// ══════════════════════════════════════════════════════════════════════
// PROVIDER FRAMEWORK V2 — ENDPOINT DEFINITIONS
// ══════════════════════════════════════════════════════════════════════

model PV2TemplateEndpoint {
  id                 String                @id @default(cuid())
  templateId         String?
  templateVersionId  String?
  operationId        String
  endpointKey        String
  displayName        String?
  httpMethod         PV2HttpMethod         @default(GET)
  relativePath       String
  absoluteUrl        String?
  protocolType       PV2TemplateProtocol   @default(REST)
  contentType        PV2ContentType        @default(APPLICATION_JSON)
  timeoutMs          Int                   @default(30000)
  authRequired       Boolean               @default(true)
  paginationStrategy PV2PaginationStrategy @default(NONE)
  idempotencyKey     String?
  idempotencyHeader  String?
  requestBodyMode    PV2RequestBodyMode    @default(JSON)
  responseBodyMode   PV2ResponseBodyMode   @default(JSON)
  isActive           Boolean               @default(true)
  isPrimary          Boolean               @default(true)
  executionOrder     Int                   @default(0)
  cachePolicyId      String?
  retryPolicyId      String?
  healthRelevant     Boolean               @default(false)
  description        String?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  template        PV2Template?            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion PV2TemplateVersion?     @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  operation       PV2Operation            @relation(fields: [operationId], references: [id], onDelete: Cascade)
  cachePolicy     PV2TemplateCachePolicy? @relation(fields: [cachePolicyId], references: [id], onDelete: SetNull)
  retryPolicy     PV2TemplateRetryPolicy? @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)

  headers          PV2TemplateEndpointHeader[]
  queryParams      PV2TemplateEndpointQueryParam[]
  pathParams       PV2TemplateEndpointPathParam[]
  bodyParams       PV2TemplateEndpointBodyParam[]
  fieldMappings    PV2TemplateFieldMapping[]
  paginationConfig PV2TemplatePaginationConfig?

  @@unique([templateId, endpointKey])
  @@unique([templateVersionId, endpointKey])
  @@index([templateId])
  @@index([templateVersionId])
  @@index([operationId])
  @@index([isActive])
  @@map("pv2_template_endpoints")
}

