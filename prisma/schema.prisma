// ══════════════════════════════════════════════════════════════════════

model PV2TemplateFieldMapping {
  id                  String                    @id @default(cuid())
  templateId          String?
  templateVersionId   String?
  endpointId          String?
  association         PV2MappingAssociation     @default(REQUEST)
  operationCode       String?
