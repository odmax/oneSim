  ttlMs                  Int           @default(300000)
  staleWhileRevalidate   Boolean       @default(false)
  staleTtlMs             Int?
  cacheKeyFields         Json?
  invalidateOnOps        Json?
  scope                  PV2CacheScope @default(REQUEST)
  sensitiveDataExclusion Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  template  PV2Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  endpoints PV2TemplateEndpoint[]

  @@unique([templateId, code])
  @@index([templateId])
  @@map("pv2_template_cache_policies")
}

// ══════════════════════════════════════════════════════════════════════
