  REVIEW_REBUILD
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model BackgroundJob {
  id            String    @id @default(cuid())
  type          JobType
  status        JobStatus @default(PENDING)
  payload       Json
  attempts      Int       @default(0)
